{
  // ============================================================
  // reverse-skill × opencode 项目配置
  // 说明：
  //  - skills.paths 动态注册 skills/ 下的 SKILL.md，按需触发、零复制。
  //    模块清单以 skills/INDEX.md 为准，不在配置中硬编码数量。
  //  - MCP 服务默认全部 enabled:false——服务未启动时开启会拖慢会话。
  //    需要哪个就把对应 enabled 改为 true（并先启动服务）。
  //  - 修改本文件后需重启 opencode 生效。
  // ============================================================
  "$schema": "https://opencode.ai/config.json",

  "skills": {
    "paths": ["./skills"]
  },

  "mcp": {
    // JS Hook / CDP / AST（stdio MCP，npx 拉取，版本已 pin）
    "jshookmcp": {
      "type": "local",
      "command": ["npx", "-y", "@jshookmcp/jshook@0.3.4"],
      "enabled": false,
      "environment": { "JSHOOK_BASE_PROFILE": "search" }
    },
    // BurpSuite MCP（需 Burp 扩展手动安装，端口 9876）
    "burpsuite": {
      "type": "remote",
      "url": "http://localhost:9876/mcp",
      "enabled": false
    },
    // anything-analyzer 浏览器自动化 + HTTP 捕获（pnpm dev 启动，端口 23816）
    "anything-analyzer": {
      "type": "remote",
      "url": "http://localhost:23816/mcp",
      "enabled": false
    },
    // IDA Pro MCP（IDA 打开文件后自动监听 127.0.0.1:13337；多实例递增）
    "idapro": {
      "type": "remote",
      "url": "http://127.0.0.1:13337/mcp",
      "enabled": false
    },
    // Ghidra MCP（插件安装后项目打开自动监听 8765）
    "ghidra": {
      "type": "remote",
      "url": "http://localhost:8765/mcp",
      "enabled": false
    }
  }
}
